{
  "name": "vite-react-fsd-starter",
  "private": true,
  "version": "0.0.0",
  "description": "Production-ready React 19 + Vite starter with Feature-Sliced Design, enforced layer boundaries, strict TypeScript, Tailwind v4 and shadcn/ui",
  "keywords": [
    "react",
    "vite",
    "typescript",
    "feature-sliced-design",
    "fsd",
    "starter",
    "template",
    "boilerplate",
    "tailwindcss",
    "shadcn-ui",
    "tanstack-query",
    "zustand",
    "docker"
  ],
  "license": "MIT-0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AlexanderMokeichuk/vite-react-fsd-starter.git"
  },
  "homepage": "https://github.com/AlexanderMokeichuk/vite-react-fsd-starter#readme",
  "bugs": "https://github.com/AlexanderMokeichuk/vite-react-fsd-starter/issues",
  "author": "Alexander Mokeichuk (https://github.com/AlexanderMokeichuk)",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run --passWithNoTests",
    "image": "bun tools/release-image.ts",
    "prepare": "lefthook install || true"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@hookform/resolvers": "^7.0.1",
    "@tanstack/react-query": "^5.105.3",
    "@tanstack/react-query-devtools": "^5.105.3",
    "@tanstack/react-table": "^8.21.3",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
    "date-fns": "^4.4.0",
    "lucide-react": "^1.66.0",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-day-picker": "^10.0.2",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.91.0",
    "react-router": "^8.5.1",
    "shadcn": "^4.23.0",
    "sonner": "^2.0.8",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7",
    "zustand": "^5.0.16"
  },
  "bun-create": {
    "postinstall": "bun tools/init-project.ts",
    "start": "bun run dev"
  },
  "devDependencies": {
    "@babel/core": "^8.1.0",
    "@clack/prompts": "^1.8.1",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@eslint/js": "^10.0.1",
    "@ianvs/prettier-plugin-sort-imports": "^4.7.1",
    "@rolldown/plugin-babel": "^0.3.0",
    "@tailwindcss/vite": "^4.3.4",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "babel-plugin-react-compiler": "^1.0.0",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-boundaries": "^7.4.1",
    "eslint-plugin-check-file": "^3.3.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "lefthook": "^2.2.2",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.3.4",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.5",
    "vitest": "^5.1.0"
  }
}
